{
 "$schema":"https://openapi.vercel.sh/vercel.json",
 "framework":null,"buildCommand":"npm run build","installCommand":"npm install --ignore-scripts --no-audit --no-fund","outputDirectory":"dist",
 "headers":[{"source":"/(.*)","headers":[
 {"key":"Content-Security-Policy","value":"default-src 'none'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self'; connect-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'none'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'"},
 {"key":"Referrer-Policy","value":"no-referrer"},{"key":"X-Content-Type-Options","value":"nosniff"},{"key":"X-Frame-Options","value":"DENY"},{"key":"X-Robots-Tag","value":"noindex, nofollow"},{"key":"Permissions-Policy","value":"camera=(), microphone=(), geolocation=()"},{"key":"Cache-Control","value":"no-cache"}]},
 {"source":"/vendor/(.*)","headers":[{"key":"Cache-Control","value":"public, max-age=31536000, immutable"}]}]
}
